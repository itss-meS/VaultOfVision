{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agriedge.local/schemas/vision_result.schema.json",
  "title": "VisionResult",
  "type": "object",
  "additionalProperties": false,
  "required": ["class_id", "label", "confidence", "bbox", "mask_polygon", "severity_level", "low_confidence"],
  "properties": {
    "class_id": { "type": "integer", "minimum": 0, "maximum": 1000 },
    "label": { "type": "string", "minLength": 1, "maxLength": 64 },
    "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
    "bbox": {
      "type": "array",
      "minItems": 4,
      "maxItems": 4,
      "items": { "type": "number", "minimum": 0, "maximum": 1 }
    },
    "mask_polygon": {
      "type": "array",
      "maxItems": 2000,
      "items": {
        "type": "array",
        "minItems": 2,
        "maxItems": 2,
        "items": { "type": "number", "minimum": 0, "maximum": 1 }
      }
    },
    "severity_level": { "type": ["integer", "null"], "minimum": 1, "maximum": 5 },
    "low_confidence": { "type": "boolean" },
    "affected_area_pct": { "type": ["number", "null"], "minimum": 0, "maximum": 100 }
  }
}
