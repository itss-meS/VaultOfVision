{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://agriedge.local/schemas/advisory_v3.schema.json",
  "title": "Advisory",
  "type": "object",
  "additionalProperties": false,
  "required": ["schema_version", "diagnosis", "severity", "actions", "tool_call", "preventive", "safety_notice", "lang"],
  "properties": {
    "schema_version": { "const": "advisory_v3" },
    "diagnosis": {
      "type": "object",
      "additionalProperties": false,
      "required": ["primary", "confidence", "differential"],
      "properties": {
        "primary": { "type": "string", "minLength": 1, "maxLength": 120 },
        "confidence": { "type": "number", "minimum": 0, "maximum": 1 },
        "differential": {
          "type": "array",
          "maxItems": 5,
          "items": { "type": "string", "minLength": 1, "maxLength": 120 }
        }
      }
    },
    "severity": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["level", "label", "affected_area_pct"],
          "properties": {
            "level": { "type": "integer", "minimum": 1, "maximum": 5 },
            "label": { "type": "string", "minLength": 1, "maxLength": 40 },
            "affected_area_pct": { "type": "number", "minimum": 0, "maximum": 100 }
          }
        }
      ]
    },
    "actions": {
      "type": "array",
      "minItems": 1,
      "maxItems": 12,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["text", "priority"],
        "properties": {
          "text": { "type": "string", "minLength": 1, "maxLength": 600 },
          "priority": { "enum": ["critical", "high", "normal"] }
        }
      }
    },
    "tool_call": {
      "oneOf": [
        { "type": "null" },
        {
          "type": "object",
          "additionalProperties": false,
          "required": ["tool", "args"],
          "properties": {
            "tool": { "enum": ["calc_dosage"] },
            "args": {
              "type": "object",
              "additionalProperties": false,
              "required": ["crop", "area_ha", "severity"],
              "properties": {
                "crop": { "enum": ["tomato"] },
                "area_ha": { "type": "number", "exclusiveMinimum": 0, "maximum": 1000 },
                "severity": { "type": "integer", "minimum": 1, "maximum": 5 }
              }
            }
          }
        }
      ]
    },
    "preventive": {
      "type": "array",
      "maxItems": 12,
      "items": { "type": "string", "minLength": 1, "maxLength": 400 }
    },
    "safety_notice": { "type": "string", "minLength": 1, "maxLength": 600 },
    "lang": { "enum": ["en", "hi", "mr", "te"] }
  }
}
